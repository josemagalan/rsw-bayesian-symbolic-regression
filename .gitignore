analisis/vendor/
analisis/priors/*.dat
# Paper figures assembled by articulo/componer_figuras*.py
articulo/borrador/
articulo/figuras/
# Python / OS
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
desktop.ini
